# BugLens Configuration

# Groq API Configuration
# Get your API key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily API Configuration
# Get your API key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Demo Mode
# Set to 'true' to run with realistic predefined analysis without requiring external API keys.
# Set to 'false' to use live Groq and Tavily APIs.
DEMO_MODE=true

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=buglens-dev-secret-key-change-in-prod
PORT=5000
